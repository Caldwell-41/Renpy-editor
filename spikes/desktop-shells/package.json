{
  "name": "loomlight-desktop-shell-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/electron/main.js",
  "scripts": {
    "build": "npm run build:node && npm run build:ui",
    "build:node": "tsc -p tsconfig.node.json",
    "build:ui": "vite build --config vite.config.mjs",
    "build:electron": "npm run build",
    "package:electron": "npm run build && node scripts/package-electron.mjs",
    "start:electron": "npm run build && electron dist/electron/main.js",
    "test": "npm run build:node && node --test dist/tests/*.test.js",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "tauri:build": "npm run build:ui && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.7.0",
    "electron": "44.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
