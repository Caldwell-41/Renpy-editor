+fn promote_pinned_stage_no_replace(
+    parent: &ParentAnchor,
+    stage: &StageAnchor,
+    final_name: &str,
+) -> Result<(), LifecycleError> {
+    use std::{mem::size_of, os::windows::{ffi::OsStrExt, io::AsRawHandle}, ptr};
+    use windows_sys::Win32::Storage::FileSystem::{
+        FileRenameInfo, SetFileInformationByHandle, FILE_RENAME_INFO, FILE_RENAME_INFO_0,
+    };
+
+    let final_path = parent.path.join(final_name);
+    let wide = final_path.as_os_str().encode_wide().collect::<Vec<_>>();
+    let bytes = size_of::<FILE_RENAME_INFO>() + wide.len() * size_of::<u16>();
+    let words = bytes.div_ceil(size_of::<usize>());
+    let mut storage = vec![0_usize; words];
+    let info = storage.as_mut_ptr().cast::<FILE_RENAME_INFO>();
+    unsafe {
+        (*info).Anonymous = FILE_RENAME_INFO_0 {
+            ReplaceIfExists: false,
+        };
+        (*info).RootDirectory = ptr::null_mut();
+        (*info).FileNameLength = (wide.len() * size_of::<u16>())
+            .try_into()
+            .map_err(|_| LifecycleError::InvalidName)?;
+        ptr::copy_nonoverlapping(wide.as_ptr(), (*info).FileName.as_mut_ptr(), wide.len());
+        let result = SetFileInformationByHandle(
+            stage.file.as_raw_handle(),
+            FileRenameInfo,
+            info.cast(),
+            bytes
+                .try_into()
+                .map_err(|_| LifecycleError::InvalidName)?,
+        );
+        if result != 0 {
+            Ok(())
+        } else if io::Error::last_os_error().kind() == io::ErrorKind::AlreadyExists {
+            Err(LifecycleError::ExistingDestination)
+        } else {
