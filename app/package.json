{
  "name": "@loomlight/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:tests": "tsc -p tsconfig.tests.json",
    "check": "npm run typecheck && npm test",
    "dev": "vite",
    "test": "npm run build:tests && node --test --test-concurrency=1 dist-tests/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.7.0",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
